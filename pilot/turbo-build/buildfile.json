{
  "version": 1,
  "actions": [
    {
      "name": "compile-probe",
      "executable": "bash",
      "args": [
        "pilot/turbo-build/compiler-wrapper.sh",
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-pedantic",
        "-O2",
        "-Ipilot/turbo-build",
        "pilot/turbo-build/probe.c",
        "-o",
        "build/turbo-build-pilot/probe"
      ],
      "cwd": ".",
      "inputs": [
        "pilot/turbo-build/probe.c",
        "pilot/turbo-build/probe.h",
        "pilot/turbo-build/compiler-wrapper.sh"
      ],
      "outputs": [
        "build/turbo-build-pilot/probe"
      ],
      "toolchain": "ubuntu-24.04-cc-c11-pilot",
      "inputs_complete": false,
      "environment_complete": false,
      "toolchain_complete": false,
      "paths_normalized": true
    }
  ]
}
