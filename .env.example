# Import these values in the parent environment before invoking CMake presets.
# CMake does not load .env itself. Never commit credentials.
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/vcpkg-cache

# Exact upstream release versions, without the v prefix.
# resolve-release requires the shared helper shipped after v0.1.2.
VCPKG_CACHE_VERSION=0.1.3

# Match these SDK roots to the compiler, architecture and dependency triplet.
SALTS_BASE_VERSION=0.1.6
SALTS_BASE_ROOT=C:/path/to/salts-base-0.1.6-windows-llvm-mingw-x64
VCPKG_INSTALLED_DIR=C:/path/to/vcpkg-cache-0.1.3/vcpkg_installed
SALTS_CI_VCPKG_INSTALLED_DIR=C:/path/to/vcpkg-cache-0.1.3/vcpkg_installed
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
VSDEVCMD_BAT=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat

# Full CTest graph only: CNet composition SDK and matching Base white-box headers.
# Product builds do not use either source tree or the SaltsCore SDK.
SALTS_CORE_VERSION=0.1.7
SALTSCORE_ROOT=C:/path/to/current-salts-core-sdk
SALTS_BASE_SOURCE_ROOT=C:/projects/cpp/turbonet/salts-base

# Native Linux/macOS profiles use this input; named Windows profiles set it.
# VCPKG_TARGET_TRIPLET=x64-linux
# ANDROID_NDK_HOME=C:/path/to/android-ndk
# ANDROID_ABI=arm64-v8a
