@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(SaltsCore 0.1 CONFIG REQUIRED)
if(NOT TARGET Salts::SIMD)
  set(Salts_FOUND FALSE)
  set(Salts_NOT_FOUND_MESSAGE "Salts requires the installed static SaltsCore SIMD module")
  return()
endif()
get_target_property(_salts_simd_kind Salts::SIMD TYPE)
get_target_property(_salts_simd_imported Salts::SIMD IMPORTED)
if(NOT _salts_simd_imported OR NOT _salts_simd_kind STREQUAL "STATIC_LIBRARY")
  set(Salts_FOUND FALSE)
  set(Salts_NOT_FOUND_MESSAGE "Salts::SIMD must be imported STATIC from SaltsCore")
  return()
endif()
unset(_salts_simd_kind)
unset(_salts_simd_imported)
include("${CMAKE_CURRENT_LIST_DIR}/SaltsTargets.cmake")
check_required_components(Salts)
