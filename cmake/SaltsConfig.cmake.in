@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

# Pre-stable extracted Salts 3.0 requires a separately installed
# versioned shared SaltsCore 0.1; never resolve old Salts::Core.
if(@SALTS_CORE_BACKED_PROFILE@)
  find_dependency(SaltsCore 0.1 CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SaltsTargets.cmake")

check_required_components(Salts)
