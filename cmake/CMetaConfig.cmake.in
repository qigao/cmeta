@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
unset(SaltsBase_DIR CACHE)
find_dependency(SaltsBase @SaltsBase_VERSION@ EXACT CONFIG REQUIRED
  PATHS "$ENV{SALTS_BASE_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/CMetaTargets.cmake")
check_required_components(CMeta)
