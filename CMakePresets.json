{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-release",
      "displayName": "Salts 0.1 / installed Core / Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$penv{SALTSCORE_PREFIX}",
        "BUILD_TESTING": "ON",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_BENCHMARKS": "OFF",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Salts 0.1 / installed Core / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$penv{SALTSCORE_PREFIX}",
        "BUILD_TESTING": "ON",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_BENCHMARKS": "OFF",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "llvm-release-ci",
      "displayName": "Salts 0.1 / LLVM Release CI",
      "generator": "Ninja",
      "binaryDir": "$penv{CMETA_BINARY_DIR}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$penv{SALTSCORE_PREFIX}",
        "SaltsCore_DIR": "$penv{SALTSCORE_PREFIX}/lib/cmake/SaltsCore",
        "CMAKE_INSTALL_PREFIX": "$penv{CMETA_INSTALL_PREFIX}",
        "CMAKE_TOOLCHAIN_FILE": "$penv{CMETA_TARGET_TOOLCHAIN_FILE}",
        "BUILD_TESTING": "ON",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_BENCHMARKS": "OFF",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "android-release-ci",
      "displayName": "Salts 0.1 / Android NDK LLVM Release CI",
      "generator": "Ninja",
      "binaryDir": "$penv{CMETA_BINARY_DIR}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$penv{SALTSCORE_PREFIX}",
        "SaltsCore_DIR": "$penv{SALTSCORE_PREFIX}/lib/cmake/SaltsCore",
        "CMAKE_INSTALL_PREFIX": "$penv{CMETA_INSTALL_PREFIX}",
        "CMAKE_TOOLCHAIN_FILE": "$penv{CMETA_TARGET_TOOLCHAIN_FILE}",
        "ANDROID_ABI": "$penv{CMETA_ANDROID_ABI}",
        "ANDROID_PLATFORM": "24",
        "ANDROID_STL": "c++_shared",
        "BUILD_TESTING": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_BENCHMARKS": "OFF",
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "native-release"
    },
    {
      "name": "debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "llvm-release-ci",
      "configurePreset": "llvm-release-ci"
    },
    {
      "name": "android-release-ci",
      "configurePreset": "android-release-ci"
    },
    {
      "name": "install-llvm-release-ci",
      "configurePreset": "llvm-release-ci",
      "targets": ["install"]
    },
    {
      "name": "install-android-release-ci",
      "configurePreset": "android-release-ci",
      "targets": ["install"]
    },
    {
      "name": "install-release",
      "configurePreset": "native-release",
      "targets": ["install"]
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    },
    {
      "name": "llvm-release-ci",
      "configurePreset": "llvm-release-ci",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    }
  ],
  "packagePresets": [],
  "workflowPresets": [],
  "vendor": {
    "qigao/cmeta": {
      "release-tag": "v0.1.000",
      "package-version": "0.1.0"
    }
  }
}
