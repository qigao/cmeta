{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-release",
      "displayName": "Salts 3 / installed Core / Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$penv{SALTSCORE_PREFIX}"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Salts 3 / installed Core / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$penv{SALTSCORE_PREFIX}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "native-release"
    },
    {
      "name": "debug",
      "configurePreset": "native-debug"
    }
  ]
}
