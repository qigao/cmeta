            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{SALTS_ROOT}",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/$env{VCPKG_WINDOWS_TRIPLET}"
